{
  "name": "toneturn",
  "private": true,
  "version": "0.42.0",
  "type": "module",
  "description": "ToneTurn — voice-first ear-training game",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "daily-keys": "rolldown scripts/daily-keys.ts --platform node --format esm -o scripts/.daily-keys.mjs > scripts/.daily-keys.log && node scripts/.daily-keys.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.181.2",
    "vexflow": "^4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
